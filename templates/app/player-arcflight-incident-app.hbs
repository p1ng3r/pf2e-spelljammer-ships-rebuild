<section class="player-arcflight-incident-content">
  <header>
    <h2>{{moduleTitle}}</h2>
    <p>Arcflight Incident</p>
  </header>

  {{#if hasIncident}}
    <article>
      <h3>{{incident.title}}</h3>
      <p><strong>Type:</strong> {{incident.sourceLabel}}</p>
      <p><strong>Status:</strong> {{incident.statusText}}</p>
      <p><strong>Severity:</strong> {{incident.severityText}}</p>
      <p><strong>Recommended station:</strong> {{incident.recommendedStationLabel}}</p>
      <p><strong>Recommended skill:</strong> {{incident.recommendedSkillLabel}}</p>

      <section>
        <h4>What is happening</h4>
        <p>{{incident.publicSummary}}</p>
      </section>

      <section>
        <h4>Why it matters</h4>
        <p>{{incident.publicOutcome}}</p>
      </section>

      {{#if incident.hasOffStationPenaltyNote}}
        <p><em>Off-station attempts may take a penalty. Coordinate with your recommended station when possible.</em></p>
      {{/if}}

      <div>
        <button type="button" data-player-incident-attempt-check>Attempt Check</button>
        <button type="button" data-player-incident-request-help>Request Help</button>
        <button type="button" data-player-incident-close>Close</button>
      </div>
    </article>
  {{else}}
    <p>No incident selected.</p>
  {{/if}}
</section>
