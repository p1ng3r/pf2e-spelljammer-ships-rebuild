<section class="ship-management-content">
  <header>
    <h2>{{moduleTitle}}</h2>
    <p>Ship Management foundation shell.</p>
  </header>

  {{#if hasShipState}}
    <article class="ship-management-body">
      <h3>{{shipState.identity.name}}</h3>
      <div class="ship-management-meta-grid">
        <p><strong>Ship ID:</strong> <code>{{activeShipId}}</code></p>
        <p><strong>Level:</strong> {{shipState.identity.level}}</p>
        <p><strong>Linked Actor ID:</strong>
          {{#if actorContext.actorId}}
            <code>{{actorContext.actorId}}</code>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
        <p><strong>Linked Actor Name:</strong>
          {{#if actorContext.actorName}}
            {{actorContext.actorName}}
          {{else if actorContext.missingActor}}
            <em>Missing actor document</em>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
        <p><strong>Linked Actor Type:</strong>
          {{#if actorContext.actorType}}
            <code>{{actorContext.actorType}}</code>
          {{else if actorContext.missingActor}}
            <em>Unknown</em>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
      </div>

      <h4 class="travel-heading">Travel (Arcflight)</h4>
      <section class="travel-summary-grid">
        <p><strong>Days Elapsed:</strong> {{travelState.daysElapsed}}</p>
        <p><strong>Days Into Leg:</strong> {{travelState.daysIntoCurrentLeg}}</p>
        <p><strong>Leg Progress:</strong> {{travelState.legProgress}} / {{routeStatus.legTarget}}</p>
        <p><strong>Progress/Day:</strong> {{travelState.progressPerDay}}</p>
        <p><strong>Current Hex:</strong>
          {{#if travelState.currentHex}}
            <code>{{travelState.currentHex}}</code>
          {{else}}
            <em>Not set</em>
          {{/if}}
        </p>
        <p><strong>Destination:</strong>
          {{#if travelState.destination}}
            <code>{{travelState.destination}}</code>
          {{else}}
            <em>Not set</em>
          {{/if}}
        </p>
        <p><strong>Maintenance Pressure:</strong> {{travelState.maintenancePressure}}</p>
        <p><strong>Encounter Pressure:</strong> {{travelState.encounterPressure}}</p>
        <p><strong>Leg Status:</strong>
          {{#if routeStatus.legComplete}}
            <span>Leg Complete</span>
          {{else}}
            <span>In Progress</span>
          {{/if}}
        </p>
      </section>

      <section class="travel-controls">
        <p class="travel-controls__current-posture">
          <strong>Current Posture:</strong>
          <span class="travel-controls__posture-pill">{{travelState.posture}}</span>
        </p>
        <div class="travel-controls__actions">
          <button type="button" data-action="advance-day">Advance Day</button>
          <label>
            <span>Posture</span>
            <select data-action="set-posture">
              {{#each postureOptions as |posture|}}
                <option value="{{posture.value}}" {{#if posture.selected}}selected{{/if}}>
                  {{posture.label}}
                </option>
              {{/each}}
            </select>
          </label>
        </div>
      </section>

      <section class="travel-route">
        <h5>Route / Destination</h5>
        <form data-action="route-leg-form">
          <label>
            <span>Destination</span>
            <input type="text" name="destination" value="{{travelState.destination}}" placeholder="Ex: Azure Ring Gate" />
          </label>
          <label>
            <span>Leg Distance (hexes)</span>
            <input type="number" name="legDistance" min="1" step="1" value="{{travelState.legDistance}}" />
          </label>
          <label>
            <span>Leg Target Progress</span>
            <input type="number" name="legProgressMax" min="1" step="1" value="{{travelState.legProgressMax}}" />
          </label>
          <button type="submit">Save Route Leg</button>
          <button type="button" data-action="reset-leg-progress">Reset Leg Progress</button>
        </form>
      </section>

      <section class="travel-maintenance">
        <h5>Travel Tasks / Maintenance Tasks</h5>
        <p><strong>Open Travel Tasks:</strong> {{travelTasks.tasks.length}}</p>
        <p><strong>Open Issues:</strong> {{maintenance.issues.length}}</p>

        <form data-action="travel-task-form">
          <label>
            <span>Travel Task</span>
            <input type="text" name="travelTaskTitle" placeholder="Ex: Plot safe Arcflight line" />
          </label>
          <label>
            <span>Task Type</span>
            <input type="text" name="travelTaskType" placeholder="travel" />
          </label>
          <label>
            <span>Check Type</span>
            <input type="text" name="travelTaskCheckType" placeholder="skill" />
          </label>
          <label>
            <span>Recommended Station</span>
            <input type="text" name="travelTaskRecommendedStation" placeholder="Ex: Sightmaster" />
          </label>
          <label>
            <span>Recommended Skill</span>
            <input type="text" name="travelTaskRecommendedSkill" placeholder="Ex: Survival" />
          </label>
          <label>
            <span>Summary</span>
            <input type="text" name="travelTaskSummary" placeholder="Quick notes for table handling" />
          </label>
          <button type="submit">Add Travel Task</button>
        </form>

        {{#if travelTasks.hasTasks}}
          <ul>
            {{#each travelTasks.tasks as |task|}}
              <li>
                <strong>{{task.title}}</strong>
                <span>({{task.taskType}} / {{task.checkType}})</span>
                <span>- {{#if task.recommendedStation}}{{task.recommendedStation}}{{else}}Unassigned{{/if}}</span>
                <span>- {{#if task.recommendedSkill}}{{task.recommendedSkill}}{{else}}No skill set{{/if}}</span>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No travel tasks logged.</em></p>
        {{/if}}

        <form data-action="maintenance-issue-form">
          <label>
            <span>Issue</span>
            <input type="text" name="issueTitle" placeholder="Ex: Aether Coil Drift" />
          </label>
          <label>
            <span>Severity</span>
            <select name="issueSeverity">
              <option value="minor">Minor</option>
              <option value="moderate">Moderate</option>
              <option value="major">Major</option>
              <option value="critical">Critical</option>
            </select>
          </label>
          <label>
            <span>Task Type</span>
            <input type="text" name="issueTaskType" placeholder="maintenance" />
          </label>
          <label>
            <span>Recommended Station</span>
            <input type="text" name="issueRecommendedStation" placeholder="Ex: Aetherwright" />
          </label>
          <label>
            <span>Recommended Skill</span>
            <input type="text" name="issueRecommendedSkill" placeholder="Ex: Crafting" />
          </label>
          <label>
            <span>Notes</span>
            <input type="text" name="issueNotes" placeholder="Optional table notes" />
          </label>
          <button type="submit">Add Issue</button>
        </form>

        {{#if maintenance.hasIssues}}
          <ul>
            {{#each maintenance.issues as |issue|}}
              <li>
                <strong>{{issue.title}}</strong>
                <span>({{issue.severity}})</span>
                <span>- {{#if issue.recommendedStation}}{{issue.recommendedStation}}{{else}}Unassigned{{/if}}</span>
                <span>- {{#if issue.recommendedSkill}}{{issue.recommendedSkill}}{{else}}No skill set{{/if}}</span>
                <button type="button" data-action="resolve-maintenance-issue" data-issue-id="{{issue.id}}">
                  Resolve
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No maintenance issues logged.</em></p>
        {{/if}}
      </section>

      <h4>Stations</h4>
      <ul>
        {{#each stations as |station|}}
          <li><strong>{{station.label}}</strong> <code>({{station.id}})</code></li>
        {{/each}}
      </ul>

      <p>This UI remains intentionally minimal and reads from the shared API/state layer.</p>
    </article>
  {{else}}
    <p>No ship state available.</p>
  {{/if}}
</section>
