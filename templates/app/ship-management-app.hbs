<section class="ship-management-content">
  <header>
    <h2>{{moduleTitle}}</h2>
    <p>Ship Management foundation shell.</p>
  </header>

  {{#if hasShipState}}
    <article class="ship-management-body">
      <h3>{{shipState.identity.name}}</h3>
      <div class="ship-management-meta-grid">
        <p><strong>Ship ID:</strong> <code>{{activeShipId}}</code></p>
        <p><strong>Level:</strong> {{shipState.identity.level}}</p>
        <p><strong>Linked Actor ID:</strong>
          {{#if actorContext.actorId}}
            <code>{{actorContext.actorId}}</code>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
        <p><strong>Linked Actor Name:</strong>
          {{#if actorContext.actorName}}
            {{actorContext.actorName}}
          {{else if actorContext.missingActor}}
            <em>Missing actor document</em>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
        <p><strong>Linked Actor Type:</strong>
          {{#if actorContext.actorType}}
            <code>{{actorContext.actorType}}</code>
          {{else if actorContext.missingActor}}
            <em>Unknown</em>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
      </div>

      <h4 class="travel-heading">Travel (Arcflight)</h4>
      <section class="travel-summary-grid">
        <p><strong>Days Elapsed:</strong> {{travelState.daysElapsed}}</p>
        <p><strong>Days Into Leg:</strong> {{travelState.daysIntoCurrentLeg}}</p>
        <p><strong>Leg Progress:</strong> {{travelState.legProgress}} / {{routeStatus.legTarget}}</p>
        <p><strong>Progress/Day:</strong> {{travelState.progressPerDay}}</p>
        <p><strong>Current Hex:</strong>
          {{#if travelState.currentHex}}
            <code>{{travelState.currentHex}}</code>
          {{else}}
            <em>Not set</em>
          {{/if}}
        </p>
        <p><strong>Destination:</strong>
          {{#if travelState.destination}}
            <code>{{travelState.destination}}</code>
          {{else}}
            <em>Not set</em>
          {{/if}}
        </p>
        <p><strong>Maintenance Pressure:</strong> {{travelState.maintenancePressure}}</p>
        <p><strong>Encounter Pressure:</strong> {{travelState.encounterPressure}}</p>
        <p><strong>Leg Status:</strong>
          {{#if routeStatus.legComplete}}
            <span>Leg Complete</span>
          {{else}}
            <span>In Progress</span>
          {{/if}}
        </p>
      </section>

      <section class="travel-controls">
        <p class="travel-controls__current-posture">
          <strong>Current Posture:</strong>
          <span class="travel-controls__posture-pill">{{travelState.posture}}</span>
        </p>
        <div class="travel-controls__actions">
          <button type="button" data-action="advance-day">Advance Day</button>
          <label>
            <span>Posture</span>
            <select data-action="set-posture">
              {{#each postureOptions as |posture|}}
                <option value="{{posture.value}}" {{#if posture.selected}}selected{{/if}}>
                  {{posture.label}}
                </option>
              {{/each}}
            </select>
          </label>
        </div>
      </section>

      <section class="travel-route">
        <h5>Route / Destination</h5>
        <form data-action="route-leg-form">
          <label>
            <span>Destination</span>
            <input type="text" name="destination" value="{{travelState.destination}}" placeholder="Ex: Azure Ring Gate" />
          </label>
          <label>
            <span>Leg Distance (hexes)</span>
            <input type="number" name="legDistance" min="1" step="1" value="{{travelState.legDistance}}" />
          </label>
          <label>
            <span>Leg Target Progress</span>
            <input type="number" name="legProgressMax" min="1" step="1" value="{{travelState.legProgressMax}}" />
          </label>
          <button type="submit">Save Route Leg</button>
          <button type="button" data-action="reset-leg-progress">Reset Leg Progress</button>
        </form>
      </section>

      <section class="travel-maintenance">
        <h5>Travel Tasks / Maintenance Tasks</h5>
        <p><strong>Open Travel Tasks:</strong> {{travelTasks.tasks.length}}</p>
        <p><strong>Open Issues:</strong> {{maintenance.issues.length}}</p>
        <p><strong>Open Events:</strong> {{travelEvents.events.length}}</p>

        <form data-action="travel-task-form">
          <label>
            <span>Travel Task</span>
            <input type="text" name="travelTaskTitle" placeholder="Ex: Plot safe Arcflight line" />
          </label>
          <label>
            <span>Task Type</span>
            <select name="travelTaskType">
              {{#each taskTypeOptions as |taskType|}}
                <option value="{{taskType.value}}">{{taskType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Check Type</span>
            <select name="travelTaskCheckType">
              {{#each checkTypeOptions as |checkType|}}
                <option value="{{checkType.value}}">{{checkType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Station</span>
            <select name="travelTaskRecommendedStation">
              <option value="">Unassigned</option>
              {{#each stationOptions as |station|}}
                <option value="{{station.value}}">{{station.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Skill</span>
            <select name="travelTaskRecommendedSkill">
              <option value="">None</option>
              {{#each skillOptions as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
              {{/each}}
              <option value="{{customSkillOption}}">Custom</option>
            </select>
          </label>
          <label>
            <span>Custom Skill (Optional)</span>
            <input type="text" name="travelTaskRecommendedSkillCustom" placeholder="Ex: sailing-lore" />
          </label>
          <label>
            <span>Summary</span>
            <input type="text" name="travelTaskSummary" placeholder="Quick notes for table handling" />
          </label>
          <button type="submit">Add Travel Task</button>
        </form>

        {{#if travelTasks.hasTasks}}
          <ul>
            {{#each travelTasks.tasks as |task|}}
              <li
                data-travel-task-id="{{task.id}}"
                data-effective-attempted-by-station="{{task.effectiveAttemptedByStation}}"
                data-effective-attempted-skill="{{task.effectiveAttemptedSkill}}"
              >
                <strong>{{task.title}}</strong>
                <span>- <strong>Status:</strong> {{task.statusLabel}}</span>
                <span>({{task.taskTypeLabel}} / {{task.checkTypeLabel}})</span>
                <span>- {{#if task.recommendedStationLabel}}{{task.recommendedStationLabel}}{{else}}Unassigned{{/if}}</span>
                <span>- {{#if task.recommendedSkill}}{{task.recommendedSkillLabel}}{{else}}No skill set{{/if}}</span>
                <span>
                  - Attempted By:
                  {{#if task.attemptedByStationLabel}}{{task.attemptedByStationLabel}}{{else}}Unassigned{{/if}}
                  /
                  {{#if task.attemptedSkill}}{{task.attemptedSkillLabel}}{{else}}No skill set{{/if}}
                </span>
                <div class="travel-task-attempt-controls">
                  <label>
                    <span>By Station</span>
                    <select name="travelTaskAttemptedByStation">
                      <option value="">Unassigned</option>
                      {{#each ../stationOptions as |station|}}
                        <option value="{{station.value}}">{{station.label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <label>
                    <span>Skill</span>
                    <select name="travelTaskAttemptedSkill">
                      <option value="">None</option>
                      {{#each ../skillOptions as |skill|}}
                        <option value="{{skill.value}}">{{skill.label}}</option>
                      {{/each}}
                    </select>
                  </label>
                </div>
                {{#if task.attemptUsesRecommendedDefaults}}
                  <p><em>Attempt fields defaulted from recommended station/skill.</em></p>
                {{/if}}
                <label>
                  <span>Attempt / Result Summary</span>
                  <input
                    type="text"
                    name="travelTaskAttemptSummary"
                    value="{{#if task.lastAttemptSummary}}{{task.lastAttemptSummary}}{{else}}{{task.summary}}{{/if}}"
                    placeholder="Manual attempt notes"
                  />
                </label>
                <button type="button" data-action="attempt-travel-task" data-task-id="{{task.id}}">
                  Attempt Check
                </button>
                <button type="button" data-action="resolve-travel-task" data-task-id="{{task.id}}">
                  Resolve
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No travel tasks logged.</em></p>
        {{/if}}

        <form data-action="maintenance-issue-form">
          <label>
            <span>Issue</span>
            <input type="text" name="issueTitle" placeholder="Ex: Aether Coil Drift" />
          </label>
          <label>
            <span>Severity</span>
            <select name="issueSeverity">
              <option value="minor">Minor</option>
              <option value="moderate">Moderate</option>
              <option value="major">Major</option>
              <option value="critical">Critical</option>
            </select>
          </label>
          <label>
            <span>Task Type</span>
            <select name="issueTaskType">
              <option value="maintenance" selected>Maintenance</option>
              <option value="travel">Travel</option>
              <option value="navigation">Navigation</option>
              <option value="engineering">Engineering</option>
              <option value="repair">Repair</option>
              <option value="general">General</option>
            </select>
          </label>
          <label>
            <span>Check Type</span>
            <select name="issueCheckType">
              {{#each checkTypeOptions as |checkType|}}
                <option value="{{checkType.value}}">{{checkType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Station</span>
            <select name="issueRecommendedStation">
              <option value="">Unassigned</option>
              {{#each stationOptions as |station|}}
                <option value="{{station.value}}">{{station.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Skill</span>
            <select name="issueRecommendedSkill">
              <option value="">None</option>
              {{#each skillOptions as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
              {{/each}}
              <option value="{{customSkillOption}}">Custom</option>
            </select>
          </label>
          <label>
            <span>Custom Skill (Optional)</span>
            <input type="text" name="issueRecommendedSkillCustom" placeholder="Ex: engineering-lore" />
          </label>
          <label>
            <span>Notes</span>
            <input type="text" name="issueNotes" placeholder="Optional table notes" />
          </label>
          <button type="submit">Add Issue</button>
        </form>

        {{#if maintenance.hasIssues}}
          <ul>
            {{#each maintenance.issues as |issue|}}
              <li>
                <strong>{{issue.title}}</strong>
                <span>({{issue.severity}})</span>
                <span>- {{issue.taskTypeLabel}} / {{issue.checkTypeLabel}}</span>
                <span>- {{#if issue.recommendedStationLabel}}{{issue.recommendedStationLabel}}{{else}}Unassigned{{/if}}</span>
                <span>- {{#if issue.recommendedSkill}}{{issue.recommendedSkillLabel}}{{else}}No skill set{{/if}}</span>
                <button type="button" data-action="resolve-maintenance-issue" data-issue-id="{{issue.id}}">
                  Resolve
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No maintenance issues logged.</em></p>
        {{/if}}

        <h5>Events</h5>
        <form data-action="travel-event-form">
          <label>
            <span>Event Title</span>
            <input type="text" name="travelEventTitle" placeholder="Ex: Unstable Aether Wake" />
          </label>
          <label>
            <span>Severity</span>
            <select name="travelEventSeverity">
              <option value="minor">Minor</option>
              <option value="moderate">Moderate</option>
              <option value="major">Major</option>
              <option value="critical">Critical</option>
            </select>
          </label>
          <label>
            <span>Event Type</span>
            <select name="travelEventType">
              {{#each eventTypeOptions as |eventType|}}
                <option value="{{eventType.value}}">{{eventType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Check Type</span>
            <select name="travelEventCheckType">
              {{#each checkTypeOptions as |checkType|}}
                <option value="{{checkType.value}}">{{checkType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Station</span>
            <select name="travelEventRecommendedStation">
              <option value="">Unassigned</option>
              {{#each stationOptions as |station|}}
                <option value="{{station.value}}">{{station.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Skill</span>
            <select name="travelEventRecommendedSkill">
              <option value="">None</option>
              {{#each skillOptions as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
              {{/each}}
              <option value="{{customSkillOption}}">Custom</option>
            </select>
          </label>
          <label>
            <span>Custom Skill (Optional)</span>
            <input type="text" name="travelEventRecommendedSkillCustom" placeholder="Ex: astronavigation-lore" />
          </label>
          <label>
            <span>Summary</span>
            <input type="text" name="travelEventSummary" placeholder="Quick event summary" />
          </label>
          <label>
            <span>Notes</span>
            <input type="text" name="travelEventNotes" placeholder="Optional GM notes" />
          </label>
          <button type="submit">Add Event</button>
        </form>

        {{#if travelEvents.hasEvents}}
          <ul>
            {{#each travelEvents.events as |event|}}
              <li>
                <strong>{{event.title}}</strong>
                <span>- <strong>Status:</strong> {{event.status}}</span>
                <span>({{event.severity}} / {{event.eventTypeLabel}} / {{event.checkTypeLabel}})</span>
                <span>- {{#if event.recommendedStationLabel}}{{event.recommendedStationLabel}}{{else}}Unassigned{{/if}}</span>
                <span>- {{#if event.recommendedSkill}}{{event.recommendedSkillLabel}}{{else}}No skill set{{/if}}</span>
                <span>- {{#if event.summary}}{{event.summary}}{{else}}No summary{{/if}}</span>
                <button type="button" data-action="resolve-travel-event" data-event-id="{{event.id}}">
                  Resolve
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No travel events logged.</em></p>
        {{/if}}
      </section>

      <h4>Stations</h4>
      <ul>
        {{#each stations as |station|}}
          <li><strong>{{station.label}}</strong> <code>({{station.id}})</code></li>
        {{/each}}
      </ul>

      <p>This UI remains intentionally minimal and reads from the shared API/state layer.</p>
    </article>
  {{else}}
    <p>No ship state available.</p>
  {{/if}}
</section>
