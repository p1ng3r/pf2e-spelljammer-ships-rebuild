<section class="ship-management-content">
  <header>
    <h2>{{moduleTitle}}</h2>
    <p>Ship Management foundation shell.</p>
  </header>

  {{#if hasShipState}}
    <article class="ship-management-body">
      <h3>{{shipState.identity.name}}</h3>
      <div class="ship-management-meta-grid">
        <p><strong>Ship ID:</strong> <code>{{activeShipId}}</code></p>
        <p><strong>Level:</strong> {{shipState.identity.level}}</p>
        <p><strong>Linked Actor ID:</strong>
          {{#if actorContext.actorId}}
            <code>{{actorContext.actorId}}</code>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
        <p><strong>Linked Actor Name:</strong>
          {{#if actorContext.actorName}}
            {{actorContext.actorName}}
          {{else if actorContext.missingActor}}
            <em>Missing actor document</em>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
        <p><strong>Linked Actor Type:</strong>
          {{#if actorContext.actorType}}
            <code>{{actorContext.actorType}}</code>
          {{else if actorContext.missingActor}}
            <em>Unknown</em>
          {{else}}
            <em>Not linked yet</em>
          {{/if}}
        </p>
      </div>

      <h4 class="travel-heading">Travel (Arcflight)</h4>
      <section class="travel-summary-grid">
        <p><strong>Days Elapsed:</strong> {{travelState.daysElapsed}}</p>
        <p><strong>Days Into Leg:</strong> {{travelState.daysIntoCurrentLeg}}</p>
        <p><strong>Leg Progress:</strong> {{travelState.legProgress}} / {{routeStatus.legTarget}}</p>
        <p><strong>Progress/Day:</strong> {{travelState.progressPerDay}}</p>
        <p><strong>Spell Engine Tier:</strong> {{galacticTravelStatus.spellEngineTier}}</p>
        <p><strong>Days per Hex:</strong> {{galacticTravelStatus.daysPerHex}}</p>
        <p><strong>Current Hex Progress:</strong> {{galacticTravelStatus.currentHexProgressLabel}}</p>
        <p><strong>Days Remaining:</strong> {{galacticTravelStatus.daysRemainingInCurrentHex}}</p>
        <p><strong>Completed Hexes:</strong> {{galacticTravelStatus.completedHexes}}</p>
        <p><strong>Current Hex:</strong>
          {{#if travelState.currentHex}}
            <code>{{travelState.currentHex}}</code>
          {{else}}
            <em>Not set</em>
          {{/if}}
        </p>
        <p><strong>Destination:</strong>
          {{#if travelState.destination}}
            <code>{{travelState.destination}}</code>
          {{else}}
            <em>Not set</em>
          {{/if}}
        </p>
        <p><strong>Maintenance Pressure:</strong> {{travelState.maintenancePressure}}</p>
        <p><strong>Encounter Pressure:</strong> {{travelState.encounterPressure}}</p>
        <p><strong>Leg Status:</strong>
          {{#if routeStatus.legComplete}}
            <span>Leg Complete</span>
          {{else}}
            <span>In Progress</span>
          {{/if}}
        </p>
      </section>

      <section class="travel-controls">
        <p class="travel-controls__current-posture">
          <strong>Current Posture:</strong>
          <span class="travel-controls__posture-pill">{{travelState.posture}}</span>
        </p>
        <div class="travel-controls__actions">
          <button type="button" data-action="advance-day">Advance Day</button>
          <label>
            <span>Posture</span>
            <select data-action="set-posture">
              {{#each postureOptions as |posture|}}
                <option value="{{posture.value}}" {{#if posture.selected}}selected{{/if}}>
                  {{posture.label}}
                </option>
              {{/each}}
            </select>
          </label>
        </div>
      </section>

      <section class="travel-route">
        <h5>Route / Destination</h5>
        <form data-action="route-leg-form">
          <label>
            <span>Destination</span>
            <input type="text" name="destination" value="{{travelState.destination}}" placeholder="Ex: Azure Ring Gate" />
          </label>
          <label>
            <span>Leg Distance (hexes)</span>
            <input type="number" name="legDistance" min="1" step="1" value="{{travelState.legDistance}}" />
          </label>
          <label>
            <span>Spell Engine Tier</span>
            <input type="number" name="spellEngineTier" min="1" step="1" value="{{galacticTravelStatus.spellEngineTier}}" />
          </label>
          <label>
            <span>Leg Target Progress</span>
            <input type="number" name="legProgressMax" min="1" step="1" value="{{travelState.legProgressMax}}" />
          </label>
          <button type="submit">Save Route Leg</button>
          <button type="button" data-action="reset-leg-progress">Reset Leg Progress</button>
        </form>
      </section>

      <section class="arcflight-log-panel">
        <h5>Recent Arcflight Activity</h5>
        {{#if arcflightLog.hasEntries}}
          <ul class="arcflight-log-list">
            {{#each arcflightLog.entries as |entry|}}
              <li class="arcflight-log-list__row">
                <p class="arcflight-log-list__meta">
                  <strong>{{entry.orderLabel}}</strong>
                  <span>{{entry.timestampLabel}}</span>
                  <span>{{entry.sourceTitleLabel}}</span>
                  {{#if entry.resultLabel}}
                    <span>{{entry.resultLabel}}</span>
                  {{/if}}
                </p>
                <p class="arcflight-log-list__text">{{entry.textLabel}}</p>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No recent Arcflight activity.</em></p>
        {{/if}}
      </section>

      <section class="travel-maintenance">
        <h5>Travel Tasks / Maintenance Tasks</h5>
        <p><strong>Open Travel Tasks:</strong> {{travelTasks.openCount}}</p>
        <p><strong>Open Issues:</strong> {{maintenance.openCount}}</p>
        <p><strong>Open Events:</strong> {{travelEvents.openCount}}</p>
        <p><strong>Open Station Requests:</strong> {{stationRequests.openCount}}</p>
        <h5>Station Requests (GM Inbox)</h5>
        <label>
          <input
            type="checkbox"
            data-action="toggle-resolved-visibility"
            data-group="station-requests"
            {{#if stationRequests.showResolved}}checked{{/if}}
          />
          <span>Show Resolved Requests</span>
        </label>
        {{#if stationRequests.hasRequests}}
          <ul class="travel-record-list">
            {{#each stationRequests.requests as |request|}}
              <li class="travel-record-row" data-station-request-id="{{request.id}}">
                <div class="travel-record-row__header">
                  <strong>{{request.title}}</strong>
                  <span class="travel-record-row__chips">
                    <span class="travel-record-chip">Station: {{request.stationLabel}}</span>
                    <span class="travel-record-chip">Source: {{request.sourceTypeLabel}}</span>
                    <span class="travel-record-chip">Status: {{request.statusLabel}}</span>
                  </span>
                </div>
                <p class="travel-record-row__summary"><strong>Request:</strong> {{request.requestTextLabel}}</p>
                <p class="travel-record-row__summary"><strong>Summary:</strong> {{request.summaryLabel}}</p>
                <label>
                  <span>Status</span>
                  <select name="stationRequestStatus">
                    {{#each request.statusOptions as |status|}}
                      <option value="{{status.value}}" {{#if status.selected}}selected{{/if}}>
                        {{status.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>
                <div class="travel-record-row__actions">
                  <button type="button" data-action="save-station-request-status" data-request-id="{{request.id}}">
                    Save Status
                  </button>
                  <button
                    type="button"
                    data-action="advance-station-request-status"
                    data-request-id="{{request.id}}"
                    data-next-status="{{request.nextStatus}}"
                    {{#unless request.canAdvanceStatus}}disabled{{/unless}}
                  >
                    Advance to {{request.nextStatusLabel}}
                  </button>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No station requests logged.</em></p>
        {{/if}}
        <label>
          <input
            type="checkbox"
            data-action="toggle-resolved-visibility"
            data-group="travel-tasks"
            {{#if travelTasks.showResolved}}checked{{/if}}
          />
          <span>Show Resolved Tasks</span>
        </label>

        <form data-action="travel-task-form">
          <label>
            <span>Travel Task</span>
            <input type="text" name="travelTaskTitle" placeholder="Ex: Plot safe Arcflight line" />
          </label>
          <label>
            <span>Task Type</span>
            <select name="travelTaskType">
              {{#each taskTypeOptions as |taskType|}}
                <option value="{{taskType.value}}">{{taskType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Check Type</span>
            <select name="travelTaskCheckType">
              {{#each checkTypeOptions as |checkType|}}
                <option value="{{checkType.value}}">{{checkType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Station</span>
            <select name="travelTaskRecommendedStation">
              <option value="">Unassigned</option>
              {{#each stationOptions as |station|}}
                <option value="{{station.value}}">{{station.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Skill</span>
            <select name="travelTaskRecommendedSkill">
              <option value="">None</option>
              {{#each skillOptions as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
              {{/each}}
              <option value="{{customSkillOption}}">Custom</option>
            </select>
          </label>
          <label>
            <span>Custom Skill (Optional)</span>
            <input type="text" name="travelTaskRecommendedSkillCustom" placeholder="Ex: sailing-lore" />
          </label>
          <label>
            <span>Summary</span>
            <input type="text" name="travelTaskSummary" placeholder="Quick notes for table handling" />
          </label>
          <label>
            <span>Players See: Summary</span>
            <input type="text" name="travelTaskPublicSummary" placeholder="Player-safe briefing summary" />
          </label>
          <label>
            <span>Players See: Outcome</span>
            <input type="text" name="travelTaskPublicOutcome" placeholder="Player-safe outcome text" />
          </label>
          <label>
            <span>DC</span>
            <input type="number" name="travelTaskDc" min="1" step="1" placeholder="Ex: 18" />
          </label>
          <button type="submit">Add Travel Task</button>
        </form>

        {{#if travelTasks.hasTasks}}
          <ul class="travel-record-list">
            {{#each travelTasks.tasks as |task|}}
              <li
                class="travel-record-row"
                data-travel-task-id="{{task.id}}"
                data-effective-attempted-by-station="{{task.effectiveAttemptedByStation}}"
                data-effective-attempted-skill="{{task.effectiveAttemptedSkill}}"
              >
                <div class="travel-record-row__header">
                  <strong>{{task.title}}</strong>
                  <span class="travel-record-row__chips">
                    <span class="travel-record-chip">Status: {{task.statusLabel}}</span>
                    <span class="travel-record-chip">{{task.taskTypeLabel}}</span>
                    <span class="travel-record-chip">{{task.checkTypeLabel}}</span>
                    <span class="travel-record-chip">Outcome Tag: {{task.outcomeTagLabel}}</span>
                  </span>
                </div>
                <div class="travel-record-row__meta-grid">
                  <p><strong>Recommended:</strong> {{#if task.recommendedStationLabel}}{{task.recommendedStationLabel}}{{else}}Unassigned{{/if}} / {{#if task.recommendedSkill}}{{task.recommendedSkillLabel}}{{else}}No skill set{{/if}}</p>
                  <p><strong>Attempted:</strong> {{#if task.attemptedByStationLabel}}{{task.attemptedByStationLabel}}{{else}}Unassigned{{/if}} / {{#if task.attemptedSkill}}{{task.attemptedSkillLabel}}{{else}}No skill set{{/if}}</p>
                  <p><strong>DC:</strong> {{#if task.dcLabel}}{{task.dcLabel}}{{else}}Not set{{/if}}</p>
                </div>
                <p class="travel-record-row__summary"><strong>Outcome:</strong> {{task.outcomeSummaryLabel}}</p>
                <p class="travel-record-row__summary"><strong>Players See:</strong> {{#if task.publicSummary}}{{task.publicSummary}}{{else}}No public details yet.{{/if}} / {{#if task.publicOutcome}}{{task.publicOutcome}}{{else}}Outcome still uncertain.{{/if}}</p>
                <div class="travel-task-attempt-controls">
                  <label>
                    <span>By Station</span>
                    <select name="travelTaskAttemptedByStation">
                      <option value="">Unassigned</option>
                      {{#each ../stationOptions as |station|}}
                        <option value="{{station.value}}">{{station.label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <label>
                    <span>Skill</span>
                    <select name="travelTaskAttemptedSkill">
                      <option value="">None</option>
                      {{#each ../skillOptions as |skill|}}
                        <option value="{{skill.value}}">{{skill.label}}</option>
                      {{/each}}
                    </select>
                  </label>
                </div>
                {{#if task.attemptUsesRecommendedDefaults}}
                  <p><em>Attempt fields defaulted from recommended station/skill.</em></p>
                {{/if}}
                <label>
                  <span>Attempt Notes</span>
                  <input
                    type="text"
                    name="travelTaskAttemptSummary"
                    value="{{#if task.lastAttemptSummary}}{{task.lastAttemptSummary}}{{else}}{{task.summary}}{{/if}}"
                    placeholder="Manual attempt notes"
                  />
                </label>
                <label>
                  <span>DC</span>
                  <input
                    type="number"
                    name="travelTaskDc"
                    min="1"
                    step="1"
                    value="{{task.dcLabel}}"
                    placeholder="Task DC"
                  />
                </label>
                <label>
                  <span>Outcome</span>
                  <input
                    type="text"
                    name="travelTaskOutcomeSummary"
                    value="{{task.resultSummary}}"
                    placeholder="Editable GM outcome text"
                  />
                </label>
                <label>
                  <span>Players See: Summary</span>
                  <input
                    type="text"
                    name="travelTaskPublicSummary"
                    value="{{task.publicSummary}}"
                    placeholder="Player-safe summary text"
                  />
                </label>
                <label>
                  <span>Players See: Outcome</span>
                  <input
                    type="text"
                    name="travelTaskPublicOutcome"
                    value="{{task.publicOutcome}}"
                    placeholder="Player-safe outcome text"
                  />
                </label>
                <label>
                  <span>Outcome Tag</span>
                  <select name="travelTaskOutcomeTag">
                    {{#each task.outcomeTagOptions as |outcomeTag|}}
                      <option value="{{outcomeTag.value}}" {{#if outcomeTag.selected}}selected{{/if}}>
                        {{outcomeTag.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>
                <button type="button" data-action="attempt-travel-task" data-task-id="{{task.id}}">
                  Attempt Check
                </button>
                <button type="button" data-action="apply-latest-task-roll" data-task-id="{{task.id}}">
                  Apply Latest Roll
                </button>
                <button type="button" data-action="save-travel-task-outcome" data-task-id="{{task.id}}">
                  Save Outcome
                </button>
                <button type="button" data-action="save-travel-task-dc" data-task-id="{{task.id}}">
                  Save DC
                </button>
                <button type="button" data-action="resolve-travel-task" data-task-id="{{task.id}}">
                  Resolve
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No travel tasks logged.</em></p>
        {{/if}}

        <form data-action="maintenance-issue-form">
          <label>
            <span>Issue</span>
            <input type="text" name="issueTitle" placeholder="Ex: Aether Coil Drift" />
          </label>
          <label>
            <span>Severity</span>
            <select name="issueSeverity">
              <option value="minor">Minor</option>
              <option value="moderate">Moderate</option>
              <option value="major">Major</option>
              <option value="critical">Critical</option>
            </select>
          </label>
          <label>
            <span>Task Type</span>
            <select name="issueTaskType">
              <option value="maintenance" selected>Maintenance</option>
              <option value="travel">Travel</option>
              <option value="navigation">Navigation</option>
              <option value="engineering">Engineering</option>
              <option value="repair">Repair</option>
              <option value="general">General</option>
            </select>
          </label>
          <label>
            <span>Check Type</span>
            <select name="issueCheckType">
              {{#each checkTypeOptions as |checkType|}}
                <option value="{{checkType.value}}">{{checkType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Station</span>
            <select name="issueRecommendedStation">
              <option value="">Unassigned</option>
              {{#each stationOptions as |station|}}
                <option value="{{station.value}}">{{station.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Skill</span>
            <select name="issueRecommendedSkill">
              <option value="">None</option>
              {{#each skillOptions as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
              {{/each}}
              <option value="{{customSkillOption}}">Custom</option>
            </select>
          </label>
          <label>
            <span>Custom Skill (Optional)</span>
            <input type="text" name="issueRecommendedSkillCustom" placeholder="Ex: engineering-lore" />
          </label>
          <label>
            <span>Notes</span>
            <input type="text" name="issueNotes" placeholder="Optional table notes" />
          </label>
          <label>
            <span>Players See: Summary</span>
            <input type="text" name="issuePublicSummary" placeholder="Player-safe issue summary" />
          </label>
          <label>
            <span>Players See: Outcome</span>
            <input type="text" name="issuePublicOutcome" placeholder="Player-safe outcome text" />
          </label>
          <label>
            <span>DC</span>
            <input type="number" name="issueDc" min="1" step="1" placeholder="Ex: 18" />
          </label>
          <button type="submit">Add Issue</button>
        </form>
        <label>
          <input
            type="checkbox"
            data-action="toggle-resolved-visibility"
            data-group="maintenance-issues"
            {{#if maintenance.showResolved}}checked{{/if}}
          />
          <span>Show Resolved Issues</span>
        </label>

        {{#if maintenance.hasIssues}}
          <ul class="travel-record-list">
            {{#each maintenance.issues as |issue|}}
              <li class="travel-record-row" data-maintenance-issue-id="{{issue.id}}">
                <div class="travel-record-row__header">
                  <strong>{{issue.title}}</strong>
                  <span class="travel-record-row__chips">
                    <span class="travel-record-chip">Status: {{issue.statusLabel}}</span>
                    <span class="travel-record-chip">{{issue.severity}}</span>
                    <span class="travel-record-chip">{{issue.taskTypeLabel}}</span>
                    <span class="travel-record-chip">{{issue.checkTypeLabel}}</span>
                    <span class="travel-record-chip">Outcome Tag: {{issue.outcomeTagLabel}}</span>
                  </span>
                </div>
                <div class="travel-record-row__meta-grid">
                  <p><strong>Recommended:</strong> {{#if issue.recommendedStationLabel}}{{issue.recommendedStationLabel}}{{else}}Unassigned{{/if}} / {{#if issue.recommendedSkill}}{{issue.recommendedSkillLabel}}{{else}}No skill set{{/if}}</p>
                  <p><strong>DC:</strong> {{#if issue.dcLabel}}{{issue.dcLabel}}{{else}}Not set{{/if}}</p>
                </div>
                <p class="travel-record-row__summary"><strong>Outcome:</strong> {{issue.outcomeSummaryLabel}}</p>
                <p class="travel-record-row__summary"><strong>Players See:</strong> {{#if issue.publicSummary}}{{issue.publicSummary}}{{else}}No public details yet.{{/if}} / {{#if issue.publicOutcome}}{{issue.publicOutcome}}{{else}}Outcome still uncertain.{{/if}}</p>
                <label>
                  <span>DC</span>
                  <input
                    type="number"
                    name="maintenanceIssueDc"
                    min="1"
                    step="1"
                    value="{{issue.dcLabel}}"
                    placeholder="Issue DC"
                  />
                </label>
                <label>
                  <span>Outcome</span>
                  <input
                    type="text"
                    name="maintenanceIssueOutcomeSummary"
                    value="{{issue.resultSummary}}"
                    placeholder="Editable GM outcome text"
                  />
                </label>
                <label>
                  <span>Players See: Summary</span>
                  <input
                    type="text"
                    name="maintenanceIssuePublicSummary"
                    value="{{issue.publicSummary}}"
                    placeholder="Player-safe summary text"
                  />
                </label>
                <label>
                  <span>Players See: Outcome</span>
                  <input
                    type="text"
                    name="maintenanceIssuePublicOutcome"
                    value="{{issue.publicOutcome}}"
                    placeholder="Player-safe outcome text"
                  />
                </label>
                <label>
                  <span>Outcome Tag</span>
                  <select name="maintenanceIssueOutcomeTag">
                    {{#each issue.outcomeTagOptions as |outcomeTag|}}
                      <option value="{{outcomeTag.value}}" {{#if outcomeTag.selected}}selected{{/if}}>
                        {{outcomeTag.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>
                <button type="button" data-action="save-maintenance-issue-outcome" data-issue-id="{{issue.id}}">
                  Save Outcome
                </button>
                <button type="button" data-action="apply-latest-issue-roll" data-issue-id="{{issue.id}}">
                  Apply Latest Roll
                </button>
                <button type="button" data-action="save-maintenance-issue-dc" data-issue-id="{{issue.id}}">
                  Save DC
                </button>
                <button type="button" data-action="resolve-maintenance-issue" data-issue-id="{{issue.id}}">
                  Resolve
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No maintenance issues logged.</em></p>
        {{/if}}

        <h5>Events</h5>
        <label>
          <input
            type="checkbox"
            data-action="toggle-resolved-visibility"
            data-group="travel-events"
            {{#if travelEvents.showResolved}}checked{{/if}}
          />
          <span>Show Resolved Events</span>
        </label>
        <form data-action="travel-event-form">
          <label>
            <span>Event Title</span>
            <input type="text" name="travelEventTitle" placeholder="Ex: Unstable Aether Wake" />
          </label>
          <label>
            <span>Severity</span>
            <select name="travelEventSeverity">
              <option value="minor">Minor</option>
              <option value="moderate">Moderate</option>
              <option value="major">Major</option>
              <option value="critical">Critical</option>
            </select>
          </label>
          <label>
            <span>Event Type</span>
            <select name="travelEventType">
              {{#each eventTypeOptions as |eventType|}}
                <option value="{{eventType.value}}">{{eventType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Check Type</span>
            <select name="travelEventCheckType">
              {{#each checkTypeOptions as |checkType|}}
                <option value="{{checkType.value}}">{{checkType.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>DC</span>
            <input type="number" name="travelEventDc" min="1" step="1" placeholder="Ex: 18" />
          </label>
          <label>
            <span>Recommended Station</span>
            <select name="travelEventRecommendedStation">
              <option value="">Unassigned</option>
              {{#each stationOptions as |station|}}
                <option value="{{station.value}}">{{station.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Recommended Skill</span>
            <select name="travelEventRecommendedSkill">
              <option value="">None</option>
              {{#each skillOptions as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
              {{/each}}
              <option value="{{customSkillOption}}">Custom</option>
            </select>
          </label>
          <label>
            <span>Custom Skill (Optional)</span>
            <input type="text" name="travelEventRecommendedSkillCustom" placeholder="Ex: astronavigation-lore" />
          </label>
          <label>
            <span>Summary</span>
            <input type="text" name="travelEventSummary" placeholder="Quick event summary" />
          </label>
          <label>
            <span>Notes</span>
            <input type="text" name="travelEventNotes" placeholder="Optional GM notes" />
          </label>
          <label>
            <span>Players See: Summary</span>
            <input type="text" name="travelEventPublicSummary" placeholder="Player-safe event summary" />
          </label>
          <label>
            <span>Players See: Outcome</span>
            <input type="text" name="travelEventPublicOutcome" placeholder="Player-safe outcome text" />
          </label>
          <button type="submit">Add Event</button>
        </form>

        {{#if travelEvents.hasEvents}}
          <ul class="travel-record-list">
            {{#each travelEvents.events as |event|}}
              <li
                class="travel-record-row"
                data-travel-event-id="{{event.id}}"
                data-effective-attempted-by-station="{{event.effectiveAttemptedByStation}}"
                data-effective-attempted-skill="{{event.effectiveAttemptedSkill}}"
              >
                <div class="travel-record-row__header">
                  <strong>{{event.title}}</strong>
                  <span class="travel-record-row__chips">
                    <span class="travel-record-chip">{{event.statusSummaryLabel}}</span>
                    <span class="travel-record-chip">{{event.severityLabel}}</span>
                    <span class="travel-record-chip">{{event.eventTypeLabel}}</span>
                    <span class="travel-record-chip">{{event.checkTypeLabel}}</span>
                    <span class="travel-record-chip">Outcome Tag: {{event.outcomeTagLabel}}</span>
                  </span>
                </div>
                <div class="travel-record-row__meta-grid">
                  <p><strong>Recommended:</strong> {{#if event.recommendedStationLabel}}{{event.recommendedStationLabel}}{{else}}Unassigned{{/if}} / {{#if event.recommendedSkill}}{{event.recommendedSkillLabel}}{{else}}No skill set{{/if}}</p>
                  <p><strong>DC:</strong> {{#if event.dcLabel}}{{event.dcLabel}}{{else}}Not set{{/if}}</p>
                  <p><strong>Attempted:</strong> {{#if event.attemptedByStationLabel}}{{event.attemptedByStationLabel}}{{else}}Unassigned{{/if}} / {{#if event.attemptedSkill}}{{event.attemptedSkillLabel}}{{else}}No skill set{{/if}}</p>
                  <p><strong>Linked Task:</strong> {{#if event.hasLinkedTask}}{{#if event.linkedTaskTitle}}{{event.linkedTaskTitle}}{{else}}<code>{{event.linkedTaskId}}</code>{{/if}}{{else}}None{{/if}}</p>
                </div>
                <p class="travel-record-row__summary"><strong>Attempt Summary:</strong> {{event.attemptSummaryLabel}}</p>
                <p class="travel-record-row__summary"><strong>Outcome:</strong> {{event.outcomeSummaryLabel}}</p>
                <p class="travel-record-row__summary"><strong>Players See:</strong> {{#if event.publicSummary}}{{event.publicSummary}}{{else}}No public details yet.{{/if}} / {{#if event.publicOutcome}}{{event.publicOutcome}}{{else}}Outcome still uncertain.{{/if}}</p>
                <div class="travel-task-attempt-controls travel-record-row__attempt-controls">
                  <label>
                    <span>By Station</span>
                    <select name="travelEventAttemptedByStation">
                      <option value="">Unassigned</option>
                      {{#each ../stationOptions as |station|}}
                        <option value="{{station.value}}">{{station.label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <label>
                    <span>Skill</span>
                    <select name="travelEventAttemptedSkill">
                      <option value="">None</option>
                      {{#each ../skillOptions as |skill|}}
                        <option value="{{skill.value}}">{{skill.label}}</option>
                      {{/each}}
                    </select>
                  </label>
                </div>
                {{#if event.attemptUsesRecommendedDefaults}}
                  <p class="travel-record-row__default-note"><em>Attempt fields defaulted from recommended station/skill.</em></p>
                {{/if}}
                <label>
                  <span>Attempt Notes</span>
                  <input
                    type="text"
                    name="travelEventAttemptSummary"
                    value="{{#if event.lastAttemptSummary}}{{event.lastAttemptSummary}}{{else}}{{event.summary}}{{/if}}"
                    placeholder="Manual attempt details"
                  />
                </label>
                <label>
                  <span>Outcome</span>
                  <input
                    type="text"
                    name="travelEventOutcomeSummary"
                    value="{{event.resultSummary}}"
                    placeholder="Editable GM outcome text"
                  />
                </label>
                <label>
                  <span>Players See: Summary</span>
                  <input
                    type="text"
                    name="travelEventPublicSummary"
                    value="{{event.publicSummary}}"
                    placeholder="Player-safe summary text"
                  />
                </label>
                <label>
                  <span>Players See: Outcome</span>
                  <input
                    type="text"
                    name="travelEventPublicOutcome"
                    value="{{event.publicOutcome}}"
                    placeholder="Player-safe outcome text"
                  />
                </label>
                <label>
                  <span>Outcome Tag</span>
                  <select name="travelEventOutcomeTag">
                    {{#each event.outcomeTagOptions as |outcomeTag|}}
                      <option value="{{outcomeTag.value}}" {{#if outcomeTag.selected}}selected{{/if}}>
                        {{outcomeTag.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  <span>DC</span>
                  <input
                    type="number"
                    name="travelEventDc"
                    min="1"
                    step="1"
                    value="{{event.dcLabel}}"
                    placeholder="Event DC"
                  />
                </label>
                <div class="travel-record-row__actions">
                  <button type="button" data-action="attempt-travel-event" data-event-id="{{event.id}}">
                    Attempt Check
                  </button>
                  <button type="button" data-action="apply-latest-event-roll" data-event-id="{{event.id}}">
                    Apply Latest Roll
                  </button>
                  <button type="button" data-action="save-travel-event-outcome" data-event-id="{{event.id}}">
                    Save Outcome
                  </button>
                  <button type="button" data-action="save-travel-event-dc" data-event-id="{{event.id}}">
                    Save DC
                  </button>
                  <button
                    type="button"
                    data-action="create-task-from-event"
                    data-event-id="{{event.id}}"
                    {{#if event.hasLinkedTask}}disabled{{/if}}
                  >
                    Create Task
                  </button>
                  <button type="button" data-action="resolve-travel-event" data-event-id="{{event.id}}">
                    Resolve
                  </button>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No travel events logged.</em></p>
        {{/if}}
      </section>

      <section class="travel-maintenance">
        <h4>Stations / Crew Assignments</h4>
        {{#if stationAssignments.hasAssignableActors}}
          <ul class="travel-record-list">
            {{#each stationAssignments.rows as |assignment|}}
              <li class="travel-record-row" data-station-id="{{assignment.stationId}}">
                <div class="travel-record-row__header">
                  <strong>{{assignment.stationLabel}}</strong>
                  <span class="travel-record-row__chips">
                    <span class="travel-record-chip">Station ID: {{assignment.stationId}}</span>
                    {{#if assignment.isNpcCrew}}
                      <span class="travel-record-chip">NPC Crew</span>
                    {{/if}}
                  </span>
                </div>
                <p class="travel-record-row__summary">
                  <strong>Assigned Actor:</strong>
                  {{assignment.assignedActorName}}
                </p>
                <label>
                  <span>Assign Character</span>
                  <select name="stationAssignedActorId">
                    <option value="">Unassigned</option>
                    {{#each assignment.actorOptions as |actor|}}
                      <option value="{{actor.value}}" {{#if actor.selected}}selected{{/if}}>
                        {{actor.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>
                <div class="travel-record-row__actions">
                  <button type="button" data-action="assign-station-actor" data-station-id="{{assignment.stationId}}">
                    Assign / Save
                  </button>
                  <button type="button" data-action="clear-station-actor" data-station-id="{{assignment.stationId}}">
                    Clear
                  </button>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No character actors are available for station assignment.</em></p>
        {{/if}}
      </section>

      <section class="travel-maintenance">
        <h4>Premade Arcflight Templates</h4>
        {{#if arcflightTemplates.hasTemplates}}
          <ul class="travel-record-list">
            {{#each arcflightTemplates.templates as |template|}}
              <li class="travel-record-row" data-arcflight-template-id="{{template.id}}">
                <div class="travel-record-row__header">
                  <strong>{{template.title}}</strong>
                  <span class="travel-record-row__chips">
                    <span class="travel-record-chip">Type: {{template.typeLabel}}</span>
                    <span class="travel-record-chip">Severity: {{template.severityLabel}}</span>
                  </span>
                </div>
                <div class="travel-record-row__meta-grid">
                  <p><strong>Recommended Station:</strong> {{template.recommendedStationLabel}}</p>
                  <p><strong>Recommended Skill:</strong> {{template.recommendedSkillLabel}}</p>
                </div>
                <div class="travel-record-row__actions">
                  <button type="button" data-action="spawn-arcflight-template" data-template-id="{{template.id}}">
                    Spawn
                  </button>
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><em>No premade Arcflight templates available.</em></p>
        {{/if}}
      </section>

      <p>This UI remains intentionally minimal and reads from the shared API/state layer.</p>
    </article>
  {{else}}
    <p>No ship state available.</p>
  {{/if}}
</section>
