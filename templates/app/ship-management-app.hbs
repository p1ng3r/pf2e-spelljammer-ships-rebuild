<section class="ship-management-content">
  <header>
    <h2>{{moduleTitle}}</h2>
    <p>Ship Management foundation shell.</p>
  </header>

  {{#if hasShipState}}
    <article>
      <h3>{{shipState.identity.name}}</h3>
      <p><strong>Ship ID:</strong> <code>{{activeShipId}}</code></p>
      <p><strong>Linked Actor ID:</strong>
        {{#if actorContext.actorId}}
          <code>{{actorContext.actorId}}</code>
        {{else}}
          <em>Not linked yet</em>
        {{/if}}
      </p>
      <p><strong>Linked Actor Name:</strong>
        {{#if actorContext.actorName}}
          {{actorContext.actorName}}
        {{else if actorContext.missingActor}}
          <em>Missing actor document</em>
        {{else}}
          <em>Not linked yet</em>
        {{/if}}
      </p>
      <p><strong>Linked Actor Type:</strong>
        {{#if actorContext.actorType}}
          <code>{{actorContext.actorType}}</code>
        {{else if actorContext.missingActor}}
          <em>Unknown</em>
        {{else}}
          <em>Not linked yet</em>
        {{/if}}
      </p>
      <p><strong>Level:</strong> {{shipState.identity.level}}</p>

      <h4>Travel (Arcflight)</h4>
      <section class="travel-controls">
        <h5>Travel Controls</h5>
        <p class="travel-controls__current-posture">
          <strong>Current Posture:</strong>
          <span class="travel-controls__posture-pill">{{travelState.posture}}</span>
        </p>
        <div class="travel-controls__actions">
          <button type="button" data-action="advance-day">Advance Day</button>
          <label>
            <span>Posture</span>
            <select data-action="set-posture">
              {{#each postureOptions as |posture|}}
                <option value="{{posture.value}}" {{#if posture.selected}}selected{{/if}}>
                  {{posture.label}}
                </option>
              {{/each}}
            </select>
          </label>
        </div>
      </section>

      <p><strong>Days Elapsed:</strong> {{travelState.daysElapsed}}</p>
      <p><strong>Current Hex:</strong>
        {{#if travelState.currentHex}}
          <code>{{travelState.currentHex}}</code>
        {{else}}
          <em>Not set</em>
        {{/if}}
      </p>
      <p><strong>Destination:</strong>
        {{#if travelState.destination}}
          <code>{{travelState.destination}}</code>
        {{else}}
          <em>Not set</em>
        {{/if}}
      </p>
      <p><strong>Leg Progress:</strong> {{travelState.legProgress}} ({{travelState.progressPerDay}}/day)</p>
      <p><strong>Days Into Current Leg:</strong> {{travelState.daysIntoCurrentLeg}}</p>
      <p><strong>Maintenance Pressure:</strong> {{travelState.maintenancePressure}}</p>
      <p><strong>Encounter Pressure:</strong> {{travelState.encounterPressure}}</p>

      <h4>Stations</h4>
      <ul>
        {{#each stations as |station|}}
          <li><strong>{{station.label}}</strong> <code>({{station.id}})</code></li>
        {{/each}}
      </ul>

      <p>This UI remains intentionally minimal and reads from the shared API/state layer.</p>
    </article>
  {{else}}
    <p>No ship state available.</p>
  {{/if}}
</section>
